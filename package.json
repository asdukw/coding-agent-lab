{
	"name": "coding-agent-lab",
	"version": "0.1.1",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.3.14",
	"bin": {
		"cagent": "./bin/cagent"
	},
	"scripts": {
		"start": "bun --no-env-file src/main.tsx",
		"dev": "bun --env-file=.env --watch src/main.tsx",
		"demo:offline": "bun --no-env-file src/demo/offline.ts",
		"demo:deepseek": "bun --no-env-file src/demo/deepseek.ts",
		"build:sandbox": "\"$SYSTEMROOT/System32/WindowsPowerShell/v1.0/powershell.exe\" -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-sandbox.ps1 -Install",
		"build:release": "\"$SYSTEMROOT/System32/WindowsPowerShell/v1.0/powershell.exe\" -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1",
		"test:release": "\"$SYSTEMROOT/System32/WindowsPowerShell/v1.0/powershell.exe\" -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-release.ps1",
		"check": "tsc --noEmit",
		"test": "bun run test:unit",
		"test:unit": "bun --no-env-file scripts/test-unit.ts",
		"test:deepseek": "bun test tests/deepseekConnectivity.test.ts",
		"test:sandbox": "bun test tests/integration/windowsSandbox.test.ts",
		"ci": "bun run check:style && bun run check && bun run test:unit",
		"lint": "biome check src tests examples package.json tsconfig.json",
		"format": "biome format --write src tests examples package.json tsconfig.json",
		"check:style": "biome check src tests examples package.json tsconfig.json",
		"fix": "biome check --write src tests examples package.json tsconfig.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@types/bun": "1.3.14",
		"@types/react": "^19.2.17",
		"ink-testing-library": "^4.0.0",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"glob": "^13.0.6",
		"ink": "^7.1.0",
		"ink-text-input": "^6.0.0",
		"openai": "^6.45.0",
		"react": "^19.2.7",
		"zod": "^4.4.3"
	}
}
